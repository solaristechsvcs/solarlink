# SolarLink configuration template — copy to .env or enter values in Wisp
# Replace all CHANGE_ME values before starting the application.
PORT=3000
BASE_URL=https://your-domain.example
DISCORD_REDIRECT_URI=https://your-domain.example/auth/discord/callback
DISCORD_CLIENT_ID=CHANGE_ME_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=CHANGE_ME_DISCORD_CLIENT_SECRET
SESSION_SECRET=CHANGE_ME_REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MYSQL_HOST=CHANGE_ME_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME_MYSQL_USER
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=solarlink
# Set to 1 only when running behind a trusted HTTPS reverse proxy
TRUST_PROXY=1
